{
  "name": "brulages-fri",
  "version": "1.0.0",
  "private": true,
  "description": "Brûlages FRI - Tennis de Table : application mobile Android et iOS (Capacitor)",
  "scripts": {
    "sync": "cap sync",
    "icons": "capacitor-assets generate --iconBackgroundColor '#ffffff' --splashBackgroundColor '#1565c0'",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "build:android": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2"
  }
}
